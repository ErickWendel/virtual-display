{
  "name": "virtual-display",
  "version": "1.0.2",
  "description": "Cross-platform tray controller for virtual displays",
  "author": "Erick Wendel",
  "main": "app/main.js",
  "desktopName": "io.virtualdisplay.Controller.desktop",
  "scripts": {
    "start": "electron .",
    "capture:screenshot": "electron scripts/capture-screenshot.js",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux AppImage --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb rpm pacman tar.gz --x64 --publish never"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ErickWendel/virtual-display.git"
  },
  "bugs": "https://github.com/ErickWendel/virtual-display/issues",
  "homepage": "https://github.com/ErickWendel/virtual-display#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^42.10.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.virtualdisplay.Controller",
    "productName": "Virtual Display",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "app/**/*",
      "assets/tray.svg",
      "assets/tray.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "linux": {
      "artifactName": "virtual-display-${version}-${arch}.${ext}",
      "category": "Utility",
      "maintainer": "Erick Wendel",
      "synopsis": "Tray controller for software-provisioned virtual displays",
      "icon": "assets/tray.png",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core"
      ]
    }
  }
}
